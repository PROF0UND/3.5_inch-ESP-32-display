// Optional local Arduino config.
// Copy this file to spotify_config.h, edit the values, and keep spotify_config.h out of Git.
//
// Use tools/spotify_pkce_helper.py to generate SPOTIFY_REFRESH_TOKEN.
// In the Spotify Developer Dashboard, add this redirect URI:
// http://127.0.0.1:8080/callback

