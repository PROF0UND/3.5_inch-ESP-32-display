// Optional local Arduino config.
// Copy this file to spotify_config.h, edit the values, and keep spotify_config.h out of Git.
//
// Use tools/spotify_pkce_helper.py to generate SPOTIFY_REFRESH_TOKEN.
// In the Spotify Developer Dashboard, add this redirect URI:
// http://127.0.0.1:8080/callback

#define WIFI_SSID "UMBC Visitor"
#define WIFI_PASSWORD ""

#define SPOTIFY_CLIENT_ID "YOUR_KEY"
#define SPOTIFY_REFRESH_TOKEN "your_spotify_refresh_token"

// How often the ESP32 checks Spotify for changed playback.
#define SPOTIFY_POLL_MS 5000

// SD card chip select used by this board.
#define SD_CS 5

// Set to true for one upload if you need to discard the token saved in ESP32 flash.
// Set it back to false after the display successfully starts.
#define SPOTIFY_RESET_SAVED_REFRESH_TOKEN false
